rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == 'contact.bellbasket1@gmail.com' || 
        request.auth.token.email == 'contact.belllbasket1@gmail.com' ||
        hasRole('admin') ||
        hasRole('hr')
      );
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      // Allow read if authenticated. Protect sensitive fields like fcmTokens if necessary.
      allow read: if isAuth();
      
      // Prevent role escalation and verification tampering
      allow create: if isAuth() && isOwner(userId) && 
        request.resource.data.role == 'customer' && 
        request.resource.data.isVerified == false;
        
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isVerified', 'plan', 'subscriptionExpiry', 'isBlocked', 'referralCode', 'fcmTokens', 'email'])
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isOwner(storeId);
      allow delete: if isAdmin();
      allow update: if isOwner(storeId) || (
        isAuth() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating'])
      ) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuth() && (request.resource.data.vendorId == request.auth.uid || hasRole('vendor') || isAdmin());
      allow update, delete: if isAuth() && (resource.data.vendorId == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        resource.data.storeId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuth() && (
        // Vendor can update status
        (resource.data.storeId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedAt', 'packedAt'])) ||
        // User can update review
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /serviceBookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuth() && (
        // Vendor can update status
        (resource.data.vendorId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        // User can update review
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review'])) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow update: if isAdmin() || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt']) && request.resource.data.isUsed == true);
      allow create, delete: if isAdmin();
    }

    match /support_requests/{requestId} {
      allow read, update: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
    }

    match /referrals/{referralId} {
      // NOTE: This collection contains staff login credentials.
      // Ideally, this should be moved to Firebase Auth or a secure backend.
      // For now, we allow read to support the custom login system, but restrict all writes.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, update, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() || isAdmin(); 
    }

    match /store_visits/{docId} {
      allow create: if true;
      allow read: if isAuth() && (resource.data.storeId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /referrals_public/{docId} {
        // Suggested collection for public referral data if needed
        allow read: if true;
    }

    // --- CAREERS PORTAL RULES ---
    match /job_posts/{jobId} {
      allow read: if true;
      allow write: if isAdmin() || (isAuth() && request.auth.token.email == 'careers@bellbasket.com');
    }

    match /job_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || (isAuth() && request.auth.token.email == 'careers@bellbasket.com');
    }
  }
}
