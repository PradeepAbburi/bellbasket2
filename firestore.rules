rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
  
  	    // --- BELL DEALS RULES ---
    match /deals/{dealId} {
      allow read: if true; // Everyone can browse active flash sales
      allow create: if request.auth != null && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.vendorId == request.auth.uid;
    }

    // --- BELL NOTES (QUICK LIST) RULES ---
    match /notes/{noteId} {
      // Only the authenticated vendor owner can access their personal list
      allow create: if request.auth != null && request.resource.data.vendorId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.vendorId == request.auth.uid;
    }

    
    // --- HELPER FUNCTIONS ---
    
    function isAuth() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.token.email == 'contact.bellbasket1@gmail.com' || 
        request.auth.token.email == 'contact.belllbasket1@gmail.com' ||
        hasRole('admin') ||
        hasRole('hr')
      );
    }

    // --- COLLECTION RULES ---

    // Default catch-all for admins
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create, delete: if isOwner(storeId);
      allow update: if isOwner(storeId) || (
        isAuth() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'rating'])
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuth() && (request.resource.data.vendorId == request.auth.uid || hasRole('vendor'));
      allow update, delete: if isAuth() && resource.data.vendorId == request.auth.uid;
    }

    match /orders/{orderId} {
      // Allow SHARED receipts: anyone can view a single order if they have the ID
      allow get: if true; 
      
      // Only the owner or store can list/query multiple orders, unless it's explicitly a thread query
      allow list: if (isAuth() && (
        resource.data.userId == request.auth.uid || 
        resource.data.storeId == request.auth.uid
      )) || (resource.data.threadId != null);
      
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        resource.data.storeId == request.auth.uid
      );
    }

    match /serviceBookings/{bookingId} {
      // Allow SHARED receipts: anyone can view a single booking if they have the ID
      allow get: if true;
      
      allow list: if isAuth() && (
        resource.data.userId == request.auth.uid || 
        resource.data.vendorId == request.auth.uid
      );
      
      allow create: if true;
      allow update, delete: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow update: if isAdmin() || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedBy', 'usedAt']) && request.resource.data.isUsed == true);
      allow create, delete: if isAdmin();
    }

    match /support_requests/{requestId} {
      allow read, update: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
    }

    match /referrals/{referralId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /store_visits/{docId} {
      allow create: if true;
      allow read: if isAuth() && (resource.data.storeId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- CAREERS PORTAL RULES ---
    match /job_posts/{jobId} {
      allow read: if true;
      allow create: if isAdmin() || (isAuth() && (request.auth.token.email == 'careers@bellbasket.com' || (hasRole('vendor') && request.resource.data.vendorId == request.auth.uid)));
      allow update, delete: if isAdmin() || (isAuth() && (request.auth.token.email == 'careers@bellbasket.com' || resource.data.vendorId == request.auth.uid));
    }

    match /job_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || 
                                    (isAuth() && (
                                      request.auth.token.email == 'careers@bellbasket.com' || 
                                      resource.data.vendorId == request.auth.uid
                                    ));
    }

    // --- BELLJOBS (LOCALITY JOB BOARD) RULES ---
    match /bell_jobs/{jobId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.vendorId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.vendorId == request.auth.uid;
    }

    match /bell_job_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || 
                                    (isAuth() && resource.data.vendorId == request.auth.uid);
    }
  }
}
