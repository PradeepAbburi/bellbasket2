{
  "crons": [
    {
      "path": "/api/daily-notify",
      "schedule": "30 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api|sitemap).*)",
      "destination": "/index.html"
    }
  ]
}